DOTENV_QUIET=true

# ─── LLM Script Generation ──────────────────────────────────────────────
# Primary: Groq Cloud (Qwen / Open-source)
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# Secondary Fallback: Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ─── Cartesia Voiceover Audio (Dynamic Multi-Key Failover Pool) ─────────
# Get keys from: https://play.cartesia.ai/keys
CARTESIA_API_KEY_1=
CARTESIA_API_KEY_2=
CARTESIA_API_KEY_3=
CARTESIA_API_KEY_4=
# Or comma/newline-separated:
# CARTESIA_API_KEYS=sk_car_xxx,sk_car_yyy,sk_car_zzz

# Cartesia Sonic Voice & Model Configuration
# Voice examples:
# Ishan (Hinglish Male Narrator): fd2ada67-c2d9-4afe-b474-6386b87d8fc3
# Kabir (Hindi Male Narrator): cb9c954d-bcaa-43ed-82bf-aeb5e88a3cb5
# Arushi (Hinglish Female Narrator): 95d51f79-c397-46f9-b49a-23763d3eaa2d
CARTESIA_VOICE_ID=fd2ada67-c2d9-4afe-b474-6386b87d8fc3
CARTESIA_MODEL_ID=sonic-3.6
CARTESIA_LANGUAGE=hi
CARTESIA_SPEED=1.25
VIDEO_SPEED=1.25
CARTESIA_VOLUME=1.6
VOICE_VOLUME=1.6

# ─── Background Music Mixing ──────────────────────────────────────────────
# Minimal background bed volume (0.02 to 0.04 recommended so voice is loud & clear)
BG_MUSIC_VOLUME=0.03

# ─── Google Drive Cloud Archiving (Automated Uploads) ──────────────────────
# Full JSON contents or Base64 string of the Google Cloud Service Account Key
GDRIVE_SERVICE_ACCOUNT_KEY=

# Google Drive folder ID of "IPO Automation" (extracted from folder URL)
GDRIVE_PARENT_FOLDER_ID=

GDRIVE_CLIENT_ID=your_client_id_here
GDRIVE_CLIENT_SECRET=your_client_secret_here
GDRIVE_REFRESH_TOKEN=
